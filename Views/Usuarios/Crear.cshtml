@model SIGTA.Models.Usuario

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Registrar usuario</h1>
        <p class="text-muted">
            Complete la información del nuevo usuario de SIGTA.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Crear" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="NombreCompleto"
                               class="form-label"></label>

                        <input asp-for="NombreCompleto"
                               class="form-control" />

                        <span asp-validation-for="NombreCompleto"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Documento"
                               class="form-label"></label>

                        <input asp-for="Documento"
                               class="form-control" />

                        <span asp-validation-for="Documento"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo"
                               class="form-label"></label>

                        <input asp-for="Correo"
                               class="form-control" />

                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono"
                               class="form-label"></label>

                        <input asp-for="Telefono"
                               class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Rol"
                               class="form-label"></label>

                        <select asp-for="Rol" class="form-select">
                            <option value="">Seleccione un rol</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Asesor de servicio">Asesor de servicio</option>
                            <option value="Mecánico">Mecánico</option>
                            <option value="Inventario">Encargado de inventario</option>
                        </select>

                        <span asp-validation-for="Rol"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="Activo"
                                   class="form-check-input" />

                            <label asp-for="Activo"
                                   class="form-check-label">
                                Usuario activo
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-sigta">
                        Guardar usuario
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>