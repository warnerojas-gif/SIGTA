@{
    ViewData["Title"] = "Inicio";
}

<div class="hero-sigta">
    <div class="container">
        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7">
                <p class="text-uppercase fw-bold sigta-subtitle">
                    Sistema de Gestión Automotriz
                </p>

                <h1 class="display-4 fw-bold mb-4">
                    Bienvenido a <span>SIGTA</span>
                </h1>

                <p class="lead mb-4">
                    Plataforma para gestionar clientes, vehículos,
                    órdenes de servicio, inventario y citas de un
                    taller automotriz.
                </p>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="btn btn-sigta btn-lg">
                    Gestionar clientes
                </a>
            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">
                <div class="dashboard-card">

                    <div class="dashboard-header">
                        <h4>Panel del taller</h4>
                        <span class="status-indicator">Activo</span>
                    </div>

                    <div class="row g-3 mt-2">

                        <div class="col-6">
                            <div class="stat-card">
                                <h3>0</h3>
                                <p>Clientes</p>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="stat-card">
                                <h3>0</h3>
                                <p>Vehículos</p>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="stat-card">
                                <h3>0</h3>
                                <p>Órdenes</p>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="stat-card">
                                <h3>0</h3>
                                <p>Repuestos</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold">Módulos del sistema</h2>
        <p class="text-muted">
            SIGTA centraliza los principales procesos del taller.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="module-card">
                <h4>Clientes</h4>
                <p>
                    Registrar, consultar y actualizar la información
                    de los clientes.
                </p>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="btn btn-outline-dark">
                    Abrir módulo
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Vehículos</h4>
                <p>
                    Administrar los vehículos asociados a cada cliente.
                </p>

                <button class="btn btn-outline-dark" disabled>
                    Próximamente
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Órdenes de servicio</h4>
                <p>
                    Registrar y realizar seguimiento a los trabajos
                    realizados en el taller.
                </p>

                <button class="btn btn-outline-dark" disabled>
                    Próximamente
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Inventario</h4>
                <p>
                    Controlar repuestos, existencias y movimientos
                    del inventario.
                </p>

                <button class="btn btn-outline-dark" disabled>
                    Próximamente
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Citas</h4>
                <p>
                    Organizar y controlar las citas programadas
                    del taller.
                </p>

                <button class="btn btn-outline-dark" disabled>
                    Próximamente
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Reportes</h4>
                <p>
                    Consultar información general sobre la operación
                    del taller.
                </p>

                <button class="btn btn-outline-dark" disabled>
                    Próximamente
                </button>
            </div>
        </div>

    </div>
</div>